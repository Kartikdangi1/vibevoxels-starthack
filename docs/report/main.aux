\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Every variant measured in one session on one pinned core of an AMD EPYC 9334 (\texttt  {results/amd-epyc-final/}; medians of 3 runs, each with 10 warm repeats). (a)~Median warm evaluation: 15.48\,s $\to $ 0.081\,s ($190\times $). (b)~Complete first run, the scored number: 35.3\,s $\to $ 0.585\,s ($60\times $). (c)~Zoom on the optimised variants: imports and setup ($\sim $0.33\,s, mostly \texttt  {import jax}) are now the largest block, and the final build's E11 flags cut XLA compile from 0.238\,s to 0.171\,s. Generated from the JSON files by \texttt  {figures/scripts/generate\_all\_figures.py}. Best viewed in color.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:benchmarks}{{4}{8}{Every variant measured in one session on one pinned core of an AMD EPYC 9334 (\texttt {results/amd-epyc-final/}; medians of 3 runs, each with 10 warm repeats). (a)~Median warm evaluation: 15.48\,s $\to $ 0.081\,s ($190\times $). (b)~Complete first run, the scored number: 35.3\,s $\to $ 0.585\,s ($60\times $). (c)~Zoom on the optimised variants: imports and setup ($\sim $0.33\,s, mostly \texttt {import jax}) are now the largest block, and the final build's E11 flags cut XLA compile from 0.238\,s to 0.171\,s. Generated from the JSON files by \texttt {figures/scripts/generate\_all\_figures.py}. Best viewed in color}{figure.4}{}}
