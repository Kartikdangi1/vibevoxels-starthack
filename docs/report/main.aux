\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces aLIGO benchmark (101 frequencies, 29 design gradients), original vs.\ \texttt  {c8066b8}. Complete first run 20.71\,s $\to $ 0.487\,s ($43\times $); warm 118.0\,ms $\to $ 11.4\,ms ($10\times $). The original's first run is almost all XLA compilation (19.63\,s), so most of the gain here comes from compiling less. Source: \texttt  {results/epyc-c8066b8/aligo/}.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:aligo-c8066b8}{{6}{10}{aLIGO benchmark (101 frequencies, 29 design gradients), original vs.\ \texttt {c8066b8}. Complete first run 20.71\,s $\to $ 0.487\,s ($43\times $); warm 118.0\,ms $\to $ 11.4\,ms ($10\times $). The original's first run is almost all XLA compilation (19.63\,s), so most of the gain here comes from compiling less. Source: \texttt {results/epyc-c8066b8/aligo/}}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 10-case benchmark suite (aLIGO, Voyager and UIFO setups, 5--301 frequencies), one run per case and version, 5 warm repeats. Geometric-mean speed-up $45\times $ on the complete first run and $25\times $ warm. The one slowdown is warm evaluation of the 5-frequency aLIGO case (4.9\,ms $\to $ 6.4\,ms), where the host path's fixed per-call overhead outweighs the tiny solve. Source: \texttt  {results/epyc-c8066b8/suite/comparison.txt}.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:suite-c8066b8}{{7}{10}{10-case benchmark suite (aLIGO, Voyager and UIFO setups, 5--301 frequencies), one run per case and version, 5 warm repeats. Geometric-mean speed-up $45\times $ on the complete first run and $25\times $ warm. The one slowdown is warm evaluation of the 5-frequency aLIGO case (4.9\,ms $\to $ 6.4\,ms), where the host path's fixed per-call overhead outweighs the tiny solve. Source: \texttt {results/epyc-c8066b8/suite/comparison.txt}}{figure.7}{}}
