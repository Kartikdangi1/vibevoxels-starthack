+def _choose_eliminated_unknowns(
+    base_matrix: np.ndarray, written_indices: np.ndarray, placing_indices: np.ndarray
+) -> tuple[np.ndarray, np.ndarray]:
+    """
+    Pick signal unknowns S whose block ``M[S, S]`` is exactly the identity for all parameters.
+
+    An unknown qualifies if its diagonal entry is a constant 1 in the base matrix
+    and is never overwritten during simulation. S is grown greedily (fewest
+    couplings first) so that no two members of S share a structurally nonzero
+    entry, which makes ``M[S, S]`` the identity. Conjugation of sideband blocks
+    does not change which entries are nonzero, and conj(1) = 1.
+
+    Returns (kept K, eliminated S) as sorted index arrays.
+    """
+    size = base_matrix.shape[0]
+    shape = np.array([[size], [size + 1]])
+    # Negative column indices address the right-hand-side column; normalize them.
+    written = written_indices % shape
+    placed = placing_indices % shape
+    overwritten = {(int(r), int(c)) for r, c in np.concatenate([written, placed], axis=1).T}
+    nonzero = {(int(r), int(c)) for r, c in zip(*np.nonzero(base_matrix[:, :size]))}
+    nonzero |= {position for position in overwritten if position[1] < size}
+
+    neighbours = [set() for _ in range(size)]
+    for row, column in nonzero:
+        if row != column:
+            neighbours[row].add(column)
+            neighbours[column].add(row)
+
+    candidates = [i for i in range(size) if base_matrix[i, i] == 1 and (i, i) not in overwritten]
+    eliminated, blocked = [], set()
+    for i in sorted(candidates, key=lambda i: (len(neighbours[i]), i)):
+        if i not in blocked:
+            eliminated.append(i)
+            blocked |= neighbours[i]
+            blocked.add(i)
+    eliminated = np.array(sorted(eliminated), dtype=int)
+    kept = np.setdiff1d(np.arange(size), eliminated)
+    return kept, eliminated
+
 
