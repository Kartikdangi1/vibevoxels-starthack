+def solve_with_adjoint_reduced(
+    augmented_matrix: jnp.ndarray,
+    adjoint_right_hand_sides: jnp.ndarray,
+    kept_indices: jnp.ndarray,
+    eliminated_indices: jnp.ndarray,
+) -> tuple[jnp.ndarray, jnp.ndarray]:
+    """
+    Same result as ``solve_with_adjoint`` on ``[M | b]``, via exact block elimination.
+
+    Parameters
+    ----------
+    augmented_matrix : jnp.ndarray
+        Augmented system ``[M | b]``, shape (N, N + 1).
+    adjoint_right_hand_sides : jnp.ndarray
+        Right-hand sides s_d for ``M^H y_d = s_d``, shape (D, N).
+    kept_indices : jnp.ndarray
+        Unknowns K kept in the reduced system, shape (NK,).
+    eliminated_indices : jnp.ndarray
+        Unknowns S eliminated beforehand, shape (NS,). ``run_build_step`` chooses S
+        such that ``M[S, S]`` is exactly the identity for every parameter value:
+        each S row has a constant 1 on its diagonal and no S unknown couples to
+        another S unknown.
+
+    Returns
+    -------
+    solution : jnp.ndarray
+        x = M^{-1} b, shape (N,).
+    adjoint_solutions : jnp.ndarray
+        y_d = M^{-H} s_d, shape (D, N).
+
+    Notes
+    -----
+    With ``M = [[A, B], [C, I]]`` in (K, S) order, the Schur complement is
+    ``R = A - B C`` and
+
+        x_K = R^{-1} (b_K - B b_S),          x_S = b_S - C x_K,
+        y_K = R^{-H} (s_K - C^H s_S),        y_S = s_S - B^H y_K.
+
+    This is plain Gaussian elimination with unit pivots, so no approximation is
+    made. Only R (NK x NK) is LU-factorized, which is far cheaper than factorizing
+    M (N x N) since the cost grows with the cube of the size.
+    """
+    matrix = augmented_matrix[:, :-1].astype(jnp.complex128)
+    right_hand_side = augmented_matrix[:, -1].astype(jnp.complex128)
+    adjoint_right_hand_sides = adjoint_right_hand_sides.astype(jnp.complex128)
+
+    a = matrix[jnp.ix_(kept_indices, kept_indices)]
+    b = matrix[jnp.ix_(kept_indices, eliminated_indices)]
+    c = matrix[jnp.ix_(eliminated_indices, kept_indices)]
+    rhs_kept, rhs_eliminated = right_hand_side[kept_indices], right_hand_side[eliminated_indices]
+    sel_kept, sel_eliminated = adjoint_right_hand_sides[:, kept_indices], adjoint_right_hand_sides[:, eliminated_indices]
+
+    reduced = a - b @ c
+    solution_kept, adjoint_kept = solve_with_adjoint(
+        reduced,
+        rhs_kept - b @ rhs_eliminated,
+        sel_kept - sel_eliminated @ jnp.conjugate(c),
+    )
+    solution_eliminated = rhs_eliminated - c @ solution_kept
+    adjoint_eliminated = sel_eliminated - adjoint_kept @ jnp.conjugate(b)
+
+    size = matrix.shape[0]
+    solution = (
+        jnp.zeros(size, dtype=jnp.complex128).at[kept_indices].set(solution_kept).at[eliminated_indices].set(solution_eliminated)
+    )
+    adjoint_solutions = (
+        jnp.zeros((adjoint_kept.shape[0], size), dtype=jnp.complex128)
+        .at[:, kept_indices].set(adjoint_kept)
+        .at[:, eliminated_indices].set(adjoint_eliminated)
+    )
+    return solution, adjoint_solutions
+
+
